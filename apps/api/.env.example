# SQLite database file, relative to the prisma/ directory
DATABASE_URL="file:./dev.db"

# Port the GraphQL API listens on
PORT=4000

# Comma-separated list of origins allowed to call the API (the Next.js app)
CORS_ORIGIN=http://localhost:3000

# Base URL of the World Bank Indicators API used by `npm run db:ingest`
WORLD_BANK_API_URL=https://api.worldbank.org/v2
