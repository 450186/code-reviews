// Prisma schema for the code-reviews technical test.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A simple greeting record used to prove the DB -> API -> UI path works.
model Greeting {
  id        Int      @id @default(autoincrement())
  message   String
  createdAt DateTime @default(now())
}
